{
  "name": "the-glass-frontier",
  "version": "0.1.0",
  "packageManager": "pnpm@10.23.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true,
  "type": "module",
  "description": "Root project for The Glass Frontier",
  "scripts": {
    "build": "turbo run build",
    "build:clean": "turbo run build:clean",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:css": "pnpm -F ./apps/client run lint:css",
    "lint:css:fix": "pnpm -F ./apps/client run lint:css:fix",
    "typecheck": "tsc -b --pretty false && tsc -p packages/app/test/tsconfig.json --pretty false && tsc -p packages/node-utils/test/tsconfig.json --pretty false && tsc -p packages/worldstate/test/tsconfig.json --pretty false && tsc -p apps/gm-api/test/tsconfig.json --pretty false && tsc -p apps/client/test/tsconfig.json --pretty false && tsc -p apps/chronicle-closer/test/tsconfig.json --pretty false && tsc -p apps/progress-api/test/tsconfig.json --pretty false",
    "test": "turbo run test",
    "db:drop": "tsx scripts/drop-database.ts",
    "db:generate-seed": "tsx scripts/generatePromptTemplateSeed.ts",
    "db:reset": "pnpm db:drop && pnpm db:migrate",
    "db:migrate": "tsx scripts/dbMigrate.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update-snapshots": "playwright test -u",
    "local": "tsx scripts/run-local-stack.ts",
    "local:ai": "tsx scripts/run-local-stack.ts --mode=live-openai",
    "local:e2e": "tsx scripts/run-local-stack.ts",
    "local:fresh": "tsx scripts/run-local-stack.ts --drop-db",
    "local:reset": "tsx scripts/run-local-stack.ts --drop-db",
    "reset:sessions": "tsx scripts/reset-session-data.ts"
  },
  "keywords": [
    "glass-frontier",
    "narrative-engine",
    "langgraph",
    "temporal"
  ],
  "author": "Codex",
  "license": "Polyform-Noncommercial-1.0.0",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.2"
    }
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.1114.0",
    "@aws-sdk/credential-providers": "^3.1114.0",
    "@eslint/js": "^9.39.1",
    "@glass-frontier/dto": "workspace:*",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.11.10",
    "@types/wait-on": "^5.3.4",
    "@types/ws": "8.5.12",
    "@vitest/coverage-v8": "^4.0.8",
    "baseline-browser-mapping": "^2.11.15",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "execa": "^9.3.0",
    "nodemon": "^3.1.11",
    "pg": "^8.13.1",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8",
    "wait-on": "^8.0.2"
  }
}
