{
  "name": "@glass-frontier/llm-client",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./embeddings": {
      "types": "./dist/embeddings.d.ts",
      "import": "./dist/embeddings.js",
      "require": "./dist/embeddings.cjs"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "build:clean": "tsc -b --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsc -p test/tsconfig.json --pretty false && vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1115.0",
    "@aws-sdk/client-secrets-manager": "^3.1115.0",
    "@glass-frontier/node-utils": "workspace:*",
    "@glass-frontier/ops": "workspace:*",
    "@glass-frontier/utils": "workspace:*",
    "openai": "^7.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
